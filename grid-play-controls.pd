#N canvas 100 100 920 520 12;
#X text 20 15 Grid commands into existing player controls. Args internal player / musical track.;
#X obj 20 65 r \$2-grid-play;
#X obj 20 105 route bang;
#X obj 20 145 s \$1-play_button;
#X obj 250 65 r \$2-grid-reverse;
#X obj 250 105 route bang;
#X obj 250 145 s \$1-dir_change;
#X obj 500 65 r \$2-grid-set-speed;
#X obj 500 105 route float;
#X obj 500 145 t f f;
#X obj 650 190 expr $f1 >= 0 && $f1 <= 4 && $f1 == floor($f1);
#X obj 500 235 spigot;
#X obj 500 275 s \$1-playback_speed_dial;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 9 1 10 0;
#X connect 10 0 11 1;
#X connect 9 0 11 0;
#X connect 11 0 12 0;
