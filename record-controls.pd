#N canvas 100 80 1200 1000 12;
#X text 25 15 Record and Stop address the selected live buffer. Switching never redirects a running writer.;
#X obj 25 65 r \$1-record_button_bang;
#X msg 25 110 start;
#X obj 220 65 r \$1-stop_button;
#X msg 220 110 stop;
#X obj 430 65 r \$1-send_target;
#X obj 430 110 makefilename %s_record;
#X obj 25 260 send;
#X obj 25 210 spigot;
#X obj 430 170 r \$1-buffer-kind;
#X obj 430 210 == 0;
#X connect 1 0 2 0;
#X connect 2 0 8 0;
#X connect 3 0 4 0;
#X connect 4 0 8 0;
#X connect 5 0 6 0;
#X connect 6 0 7 1;
#X connect 8 0 7 0;
#X connect 9 0 10 0;
#X connect 10 0 8 1;
