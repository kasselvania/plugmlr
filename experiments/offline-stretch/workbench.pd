#N canvas 40 40 1240 850 12;
#X text 25 15 OFFLINE STRETCH WORKBENCH - isolated compatibility experiment - no mlr.pd dependency;
#X text 25 45 No DAC or hardware input. RUN captures 12 seconds then stops. DSP must already be on.;
#X obj 30 100 bng 30 250 50 0 empty empty RUN_12s 36 15 0 14 #faf8f2 #347c72 #283d3a;
#X obj 270 100 bng 30 250 50 0 empty empty STOP 36 15 0 14 #faf8f2 #b75e49 #283d3a;
#X obj 30 150 t b b b;
#X text 25 200 A / bundled phase vocoder - signal-rate render at wall-clock speed (not background/offline);
#X msg 30 240 open /tmp/plugmlr-stretch-workbench/source.wav;
#X obj 30 300 else/pvoc.player~ -speed 50 -transp 1200 2;
#X text 430 250 Input 2 seconds / 220 Hz L / 330 Hz R. Speed 50 percent / pitch +1200 cents.;
#X text 430 280 Expected rendered length about 4 seconds / 440 Hz L / 660 Hz R.;
#X msg 30 345 stop;
#X text 25 395 B / optional external Rubber Band worker - invoke render_worker.py separately;
#X text 25 420 Threaded import into private arrays. No active application buffer is changed.;
#X msg 30 455 load /tmp/plugmlr-stretch-workbench/rubberband.wav;
#X obj 30 495 else/sfload -t \$0-stage;
#X obj 460 455 array define 0-\$0-stage 4;
#X obj 460 490 array define 1-\$0-stage 4;
#X obj 30 535 list prepend loaded;
#X obj 30 570 s \$0-log;
#X text 25 620 C / reference continuity - independent oscillators run through both processing and loading;
#X obj 30 655 osc~ 997;
#X obj 30 690 *~ 0.05;
#X obj 270 655 osc~ 1499;
#X obj 270 690 *~ 0.05;
#X obj 720 690 writesf~ 4;
#X msg 720 610 open -bytes 4 /tmp/plugmlr-stretch-workbench/capture.wav;
#X obj 720 150 delay 50;
#X obj 720 185 t b b;
#X msg 875 220 start;
#X obj 950 150 delay 12000;
#X obj 1080 150 delay 14000;
#X obj 950 300 t b b b;
#X msg 1010 345 stop;
#X obj 830 255 delay 6500;
#X obj 950 390 delay 100;
#X obj 950 425 f \$0;
#X msg 750 465 write -wave -bytes 4 /tmp/plugmlr-stretch-workbench/staged.wav 0-\$1-stage 1-\$1-stage;
#X obj 750 500 soundfiler;
#X msg 950 535 completed;
#X msg 350 345 pvoc_finished;
#X obj 750 740 r \$0-log;
#X obj 750 775 print stretch-workbench;
