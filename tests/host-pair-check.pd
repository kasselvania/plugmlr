#X msg 200 390 read \$1 \, bang;
#X obj 200 430 qlist;
#X obj 20 390 t b b b b;
#X obj 550 430 delay 10000;
#X msg 130 470 open -bytes 4 /tmp/host-pair-mixers.wav;
#X msg 20 510 start;
#X msg 320 470 \; 17-test-capture start /tmp/host-pair-17.wav 10000 \; 18-test-capture start /tmp/host-pair-18.wav 10000;
#X obj 550 470 t b b b;
#X msg 620 510 \; 17-host-control stop \; 18-host-control stop;
#X msg 550 550 stop;
#X obj 550 590 print host-pair-stopped;
#X obj 700 550 delay 300;
#X msg 700 590 1;
