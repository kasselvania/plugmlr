#N canvas 120 100 1100 700 12;
#X text 25 15 Passive test tap. Args: track number and player dollar-zero ID.;
#X text 25 40 Send: TRACK-test-capture start PATH DURATION_MS (100..30000).;
#X text 25 65 Float WAV: stereo / master frame / rate / reader 0 frame+gain / reader 1 frame+gain.;
#X obj 25 115 r~ \$1-voice_audio;
#X obj 25 150 snake~ out 2;
#X obj 290 115 r~ \$2-playhead_pos;
#X obj 510 115 r \$2-rate_multiplier;
#X obj 510 150 sig~ 1;
#X obj 25 575 writesf~ 8;
#X obj 25 220 r \$1-test-capture;
#X obj 25 255 route start stop;
#X obj 25 290 spigot 1;
#X obj 25 325 unpack s f;
#X obj 200 325 clip 100 30000;
#X obj 25 360 t b s b;
#X msg 235 395 0;
#X msg 115 395 open -bytes 4 \$1;
#X obj 25 435 t b b;
#X obj 360 435 delay 3000;
#X msg 25 470 start;
#X obj 360 470 t b b b;
#X msg 425 505 stop;
#X msg 360 505 1;
#X obj 25 510 print capture-started;
#X obj 510 540 print capture-stopped;
#X text 600 315 Arm the Pd timer before starting writesf~.;
#X text 600 350 Ignore starts during capture and for 250 ms after stop.;
#X obj 220 290 t b b;
#X msg 275 360 stop;
