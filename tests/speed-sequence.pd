#N canvas 100 100 1420 1200 12;
#X text 20 15 Native original-player command sequence. Args: track and player ID.;
#X text 20 40 PLAYER-test-speed symbol OUTPUT.wav. Recorder must already be attached.;
#X text 20 65 Capture stops at 24s. Playback stops at 23s. Use the included 44100 Hz drum file.;
#X obj 20 110 r \$2-test-speed;
#X obj 20 145 spigot 1;
#X obj 20 180 t b s b;
#X msg 500 180 0;
#X obj 180 220 pack s 24000;
#X obj 180 255 list prepend start;
#X obj 180 290 list trim;
#X obj 180 325 s \$1-test-capture;
#X obj 20 370 t b b b b b b b b b b b b b b;
#X obj 900 330 print speed-step-ms;
#X obj 20 430 delay 0;
#X obj 20 465 t b b;
#X msg 200 465 0;
#X obj 20 495 f \$2;
#X msg 20 530 \; \$1-stop_button bang \; \$1-rate_slew-duration-i 0 \; \$1-playback_speed_dial 2 \; \$1-play_button bang \; \$1-set_active_loop_start 44100 \; \$1-set_active_loop_end 132300 \; \$1-buffer_and_playhead_update_and_exe 44100, f 38;
#X obj 360 430 delay 2000;
#X obj 360 465 t b b;
#X msg 540 465 2000;
#X obj 360 495 f \$2;
#X msg 360 530 \; \$1-playback_speed_dial 1, f 38;
