#N canvas 100 80 750 450 12;
#X obj 20 30 bounded-player-capture \$1 \$2;
#X obj 20 80 r \$1-host-control;
#X obj 20 120 route play stop reverse speed slew;
#X obj 20 170 s \$2-play_button;
#X obj 200 170 s \$2-stop_button;
#X obj 380 170 s \$2-dir_change;
#X obj 20 210 s \$2-playback_speed_dial;
#X obj 300 210 s \$2-rate_slew-duration-i;
#X obj 20 260 loadbang;
#X obj 20 300 f \$2;
#X obj 20 340 print host-player-\$1-id;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 2 1 4 0;
#X connect 2 2 5 0;
#X connect 2 3 6 0;
#X connect 2 4 7 0;
#X connect 8 0 9 0;
