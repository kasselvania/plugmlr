#N canvas 120 100 1080 830 12;
#X text 20 15 Control-only reverse checks for the original mlr.pd player.;
#X text 20 42 Enter the player ID printed as N-loop_start in the console first.;
#X floatatom 20 95 8 1 1000000 0 Player_ID - - 0;
#X obj 20 128 s \$0-player;
#X obj 790 128 r \$0-player;
#X obj 20 180 bng 24 250 50 0 empty empty Toggle_direction 0 -10 0 12 #fcfcfc #000000 #000000;
#X obj 20 220 f;
#X msg 20 260 \; \$1-dir_change bang, f 27;
#X obj 250 180 bng 24 250 50 0 empty empty Region_1_to_3s 0 -10 0 12 #fcfcfc #000000 #000000;
#X obj 250 220 f;
#X msg 250 260 \; \$1-set_active_loop_start 44100 \; \$1-set_active_loop_end 132300 \; \$1-buffer_and_playhead_update_and_exe 44100, f 27;
#X obj 480 180 bng 24 250 50 0 empty empty Full_drum_loop 0 -10 0 12 #fcfcfc #000000 #000000;
#X obj 480 220 f;
#X msg 480 260 \; \$1-set_active_loop_start 0 \; \$1-set_active_loop_end 631881 \; \$1-buffer_and_playhead_update_and_exe 0, f 27;
#X obj 710 180 bng 24 250 50 0 empty empty Half_speed 0 -10 0 12 #fcfcfc #000000 #000000;
#X obj 710 220 f;
#X msg 710 260 \; \$1-playback_speed_dial 1, f 27;
#X obj 20 430 bng 24 250 50 0 empty empty Normal_speed 0 -10 0 12 #fcfcfc #000000 #000000;
#X obj 20 470 f;
#X msg 20 510 \; \$1-playback_speed_dial 2, f 27;
#X obj 250 430 bng 24 250 50 0 empty empty Double_speed 0 -10 0 12 #fcfcfc #000000 #000000;
#X obj 250 470 f;
#X msg 250 510 \; \$1-playback_speed_dial 3, f 27;
#X obj 480 430 bng 24 250 50 0 empty empty Near_region_start 0 -10 0 12 #fcfcfc #000000 #000000;
#X obj 480 470 f;
#X msg 480 510 \; \$1-buffer_and_playhead_update_and_exe 44101, f 27;
#X obj 710 430 bng 24 250 50 0 empty empty Near_region_end 0 -10 0 12 #fcfcfc #000000 #000000;
#X obj 710 470 f;
#X msg 710 510 \; \$1-buffer_and_playhead_update_and_exe 132299, f 27;
#X text 20 690 Region buttons use frame indexes for the included 44100 Hz DrumLoop.wav.;
#X text 20 718 Start audio in mlr.pd first. The panel does not load audio or run DSP.;
#X obj 20 610 bng 24 250 50 0 empty empty Three_direction_toggles 0 -10 0 12 #fcfcfc #000000 #000000;
#X obj 250 610 f;
#X msg 350 610 \; \$1-dir_change bang \; \$1-dir_change bang \; \$1-dir_change bang, f 30;
