#N canvas 100 100 1000 1100 12;
#X obj 30 30 r grid-musical-check;
#X obj 30 65 spigot 1;
#X obj 30 100 t b b b b;
#X msg 460 140 0;
#X obj 650 180 delay 16000;
#X msg 260 140 open -bytes 4 /tmp/grid-musical.wav;
#X msg 30 140 start;
#X obj 30 430 writesf~ 4;
#X obj 30 230 r~ 1-voice_audio;
#X obj 30 270 snake~ out 2;
#X obj 260 230 r~ plugmlr-record-check-left;
#X obj 490 230 r~ plugmlr-record-check-right;
#X obj 650 220 t b b b;
#X msg 740 260 stop;
#X obj 650 340 print grid-musical-stopped;
#X obj 30 501 delay 100;
#X msg 250 501 bang;
#X obj 460 501 s \$1-play_button;
#X obj 30 540 delay 4000;
#X msg 250 540 8;
#X obj 460 540 s row_1;
#X obj 30 580 delay 8000;
#X msg 250 580 3;
#X obj 460 580 s row_1;
#X obj 30 600 delay 10000;
#X msg 250 600 bang;
#X obj 460 600 s \$1-dir_change;
#X obj 30 620 delay 12000;
#X msg 250 620 12;
#X obj 460 620 s row_1;
#X obj 30 650 delay 15000;
#X msg 250 650 bang;
#X obj 460 650 s \$1-stop_button;
#X obj 650 300 s \$1-stop_button;
#X text 30 200 One-shot 16 second capture. All stop timers armed before recording. No source or DAC.;
