#N canvas 100 80 1200 1000 12;
#X text 20 15 Bounded 12 second check of the actual player. Arg player ID. No source or DAC.;
#X obj 20 55 bounded-player-capture 1 \$1;
#X obj 20 100 r tempo-check;
#X obj 20 135 spigot 1;
#X obj 20 175 t b s b;
#X obj 440 175 t b b b b;
#X msg 740 215 0;
#X obj 440 780 text define \$0-events;
#X msg 600 215 clear;
#X obj 900 400 timer;
#X msg 440 215 \; 1-test-capture start /tmp/tempo-readers.wav 12000;
#X msg 200 215 read \$1 \, bang;
#X obj 200 255 qlist;
#X obj 20 215 t b b b;
#X obj 400 350 delay 12000;
#X obj 20 450 writesf~ 2;
#X msg 120 300 open -bytes 4 /tmp/tempo-master.wav;
#X msg 20 300 start;
#X obj 20 360 r~ plugmlr-record-check-left;
#X obj 220 360 r~ plugmlr-record-check-right;
#X obj 400 390 t b b b b;
#X msg 720 440 \; tempo-player stop \; global-transport 0;
#X msg 600 440 stop;
#X msg 470 480 write /tmp/tempo-events.txt;
#X obj 400 520 print tempo-check-stopped;
#X obj 400 560 delay 300;
#X msg 400 600 1;
#X obj 800 300 r \$0-log;
#X obj 800 350 t l b;
#X obj 800 450 list prepend;
#X obj 800 490 text insert \$0-events 1e+09;
#X obj 20 650 r \$1-target-rate;
#X obj 20 680 list prepend target-rate;
#X obj 20 710 s \$0-log;
#X obj 20 750 r \$1-rate_multiplier;
#X obj 20 780 list prepend rate_multiplier;
#X obj 20 810 s \$0-log;
#X obj 20 850 r \$1-tempo-fit-status;
#X obj 20 880 list prepend tempo-fit-status;
#X obj 20 910 s \$0-log;
#X obj 20 950 r \$1-clock_mode_enable_i;
#X obj 20 980 list prepend clock_mode_enable_i;
#X obj 20 1010 s \$0-log;
#X obj 20 1050 r \$1-num_beats_for_segment_i;
#X obj 20 1080 list prepend num_beats_for_segment_i;
#X obj 20 1110 s \$0-log;
#X obj 20 1150 r \$1-is_playing_flag;
#X obj 20 1180 list prepend is_playing_flag;
#X obj 20 1210 s \$0-log;
#X obj 20 1250 r \$1-is_paused_flag;
#X obj 20 1280 list prepend is_paused_flag;
#X obj 20 1310 s \$0-log;
#X obj 20 1350 r \$1-play-position-frames;
#X obj 20 1380 list prepend play-position-frames;
#X obj 20 1410 s \$0-log;
#X obj 500 850 r 1-tempo-fit-error;
#X obj 500 880 list prepend 1-tempo-fit-error;
#X obj 500 910 s \$0-log;
#X obj 500 950 r 1-reset-fired;
#X obj 500 980 list prepend 1-reset-fired;
#X obj 500 1010 s \$0-log;
#X obj 500 1050 r ppq;
#X obj 500 1080 list prepend ppq;
#X obj 500 1110 s \$0-log;
#X obj 800 650 r tempo-player;
#X obj 800 690 route play stop reverse speed slew;
#X obj 800 750 s \$1-play_button;
#X obj 880 750 s \$1-stop_button;
#X obj 960 750 s \$1-dir_change;
#X obj 1040 750 s \$1-playback_speed_dial;
#X obj 1120 750 s \$1-rate_slew-duration-i;
#X obj 800 820 loadbang;
#X obj 800 860 f \$1;
#X obj 800 900 print tempo-player-id;
