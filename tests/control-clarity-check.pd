#N canvas 100 100 750 480 12;
#X text 20 15 Control-only observer. Arg: original player dollar-zero. No audio or automatic commands.;
#X obj 20 60 r 1-quantizer;
#X obj 20 95 list prepend track1-mode;
#X obj 230 60 r 2-quantizer;
#X obj 230 95 list prepend track2-mode;
#X obj 20 150 r \$1-selected_slice;
#X obj 20 185 list prepend slice;
#X obj 230 150 r \$1-key_quantize_selection;
#X obj 230 185 list prepend grid;
#X obj 20 270 text insert \$0-events 1e+09;
#X obj 20 320 text define \$0-events;
#X obj 440 60 r clarity-write;
#X msg 440 95 write /tmp/plugmlr-control-clarity.txt;
#X obj 440 150 r clarity-grid;
#X obj 440 185 s \$1-key_quantize_selection;
#X obj 230 270 print clarity-event;
#X connect 1 0 2 0;
#X connect 3 0 4 0;
#X connect 5 0 6 0;
#X connect 7 0 8 0;
#X connect 2 0 9 0;
#X connect 4 0 9 0;
#X connect 6 0 9 0;
#X connect 8 0 9 0;
#X connect 2 0 15 0;
#X connect 4 0 15 0;
#X connect 6 0 15 0;
#X connect 8 0 15 0;
#X connect 11 0 12 0;
#X connect 12 0 10 0;
#X connect 13 0 14 0;
