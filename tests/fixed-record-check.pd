#N canvas 100 100 1000 730 12;
#X text 25 15 Actual writer check. Constant stereo input and sentinel guards. No DAC.;
#X obj 25 65 sig~ 0.125;
#X obj 190 65 sig~ 0.25;
#X obj 25 115 ../fixed-record~ \$0-left \$0-right;
#X obj 25 170 t a a;
#X obj 190 210 print fixed-record-check;
#X obj 25 210 route done;
#X obj 25 250 t b f;
#X obj 200 290 print written-frames;
#X obj 25 290 f \$0;
#X msg 25 330 write -wave -bytes 4 /tmp/plugmlr-fixed-record-check.wav \$1-left \$1-right;
#X obj 25 380 soundfiler;
#X obj 25 420 print exported-frames;
#X obj 600 65 array define \$0-left 4864;
#X obj 600 105 array define \$0-right 4864;
#X obj 600 170 r fixed-record-check;
#X obj 600 210 route start stop;
#X obj 600 250 t b b;
#X msg 710 290 const -0.5;
#X msg 600 290 start 4800;
#X msg 860 250 stop;
#X text 25 510 Send fixed-record-check start. Writer stops by its signal frame limit.;
#X text 25 545 Expected: done 4800. Frames 0..4799 equal 0.125/0.25 \, then 64 untouched frames.;
#X text 25 580 Use fixed-record-early / fixed-record-repeat / fixed-record-immediate bangs for bounded cases.;
