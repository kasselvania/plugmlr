#N canvas 100 80 1200 800 12;
#X text 20 15 Pattern check - two isolated players - no DAC or recording - 9 second stop;
#X obj 20 55 loadbang;
#X obj 20 95 delay 1000;
#X obj 20 135 t b b b;
#X obj 950 100 timer;
#X obj 900 380 text define \$0-events;
#X msg 350 175 clear;
#X obj 20 220 qlist;
#X msg 20 180 read /tmp/plugmlr-cut-pattern/score.txt \, bang;
#X obj 20 260 sample-data 901;
#X obj 20 300 sample_player_rebuild 901;
#X obj 20 340 array define 0-live_buffer_901 4;
#X obj 20 375 array define 1-live_buffer_901 4;
#X obj 20 420 se328269d3-buffer-view-data live 901;
#X obj 370 260 sample-data 902;
#X obj 370 300 sample_player_rebuild 902;
