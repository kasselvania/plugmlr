#X obj 370 375 array define 1-live_buffer_902 4;
#X obj 370 420 se328269d3-buffer-view-data live 902;
#X obj 20 500 r pcheck-input;
#X obj 20 540 pattern-control;
#X obj 20 580 unpack f f f;
#X obj 180 620 makefilename row_90%d;
#X obj 20 660 send;
#X obj 550 500 r pcheck-cut;
#X obj 550 540 list prepend accepted;
#X obj 550 580 s pcheck-log;
#X obj 550 500 r pcheck-led;
#X obj 550 540 list prepend led;
#X obj 550 580 s pcheck-log;
#X obj 900 55 r pcheck-log;
#X obj 900 140 t l b;
#X obj 900 185 list prepend;
#X obj 900 230 text insert \$0-events 1e+09;
#X obj 900 430 r pcheck-finish;
#X obj 900 470 t b b;
#X obj 700 140 delay 9000;
#X msg 700 185 stop;
#X msg 700 230 rewind;
#X msg 1050 510 \; pcheck-command stop \; editor-test-901 stop \; editor-test-902 stop \; pcheck-connected 0;
#X msg 900 550 write /tmp/plugmlr-cut-pattern/events.txt;
#X obj 900 590 print pattern-check-done;
