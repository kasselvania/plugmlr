#N canvas 100 100 850 560 12;
#X text 25 15 One local stereo bus. No cross-instance transport. One companion per bus.;
#X obj 25 65 inlet~;
#X obj 165 65 inlet~;
#X obj 25 125 snake~ in 2;
#X obj 25 185 throw~ \$0-idle;
#X obj 25 240 catch~ \$0-idle 2;
#X obj 355 65 inlet;
#X obj 355 105 route float;
#X obj 355 145 t f f;
#X obj 530 180 expr ($f1 >= 0) && ($f1 <= 16) && ($f1 == floor($f1));
#X obj 355 220 spigot;
#X obj 355 260 sel 0;
#X obj 355 300 symbol \$0-idle;
#X obj 540 300 makefilename plugmlr-input-%d;
#X obj 355 345 list prepend set;
#X obj 355 385 list trim;
#X text 25 450 Bus 0 disconnects. Bus 1..16 selects the local stereo destination.;
#X connect 1 0 3 0;
#X connect 2 0 3 1;
#X connect 3 0 4 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 1 9 0;
#X connect 8 0 10 0;
#X connect 9 0 10 1;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
#X connect 11 1 13 0;
#X connect 12 0 14 0;
#X connect 13 0 14 0;
