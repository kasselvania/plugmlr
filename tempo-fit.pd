#N canvas 100 80 1300 900 12;
#X text 20 15 Fit whole content to beats then use the original speed glide. Args player / track.;
#X obj 20 70 inlet preset;
#X obj 20 710 f 1;
#X obj 20 790 pack f f f f f f;
#X obj 20 665 r \$0-recalc;
#X obj 600 575 s \$0-recalc;
#X obj 20 110 route float;
#X obj 20 150 t f f;
#X obj 20 190 expr $f1 >= 0.25 && $f1 <= 4, f 45;
#X obj 20 230 spigot;
#X obj 20 270 sel 0;
#X msg 20 310 invalid_preset;
#X obj 20 350 s \$2-tempo-fit-error;
#X obj 20 390 t b f;
#X obj 510 70 r \$2-clock_mode_enabled;
#X obj 510 110 route float;
#X obj 510 150 t f f;
#X obj 510 190 expr $f1 == 0 || $f1 == 1, f 45;
#X obj 510 230 spigot;
#X obj 510 270 sel 0;
#X msg 510 310 invalid_clock_mode_enabled;
#X obj 510 350 s \$2-tempo-fit-error;
#X obj 510 390 t f f;
#X obj 510 430 s \$1-clock_mode_enable_i;
#X obj 510 470 t b f;
#X obj 800 70 loadbang;
#X msg 800 110 0;
#X obj 1050 70 r \$2-num_beats_for_segment;
#X obj 1050 110 route float;
#X obj 1050 150 t f f;
#X obj 1050 190 expr $f1 >= 1 && $f1 <= 64 && $f1 == int($f1), f 45;
#X obj 1050 230 spigot;
#X obj 1050 270 sel 0;
#X msg 1050 310 invalid_num_beats_for_segment;
#X obj 1050 350 s \$2-tempo-fit-error;
#X obj 1050 390 t f f;
#X obj 1050 430 s \$1-num_beats_for_segment_i;
#X obj 1050 470 t b f;
#X obj 1380 70 loadbang;
#X msg 1380 110 4;
#X obj 1620 70 r project_bpm;
#X obj 1620 110 route float;
#X obj 1620 150 t f f;
#X obj 1620 190 expr $f1 >= 30 && $f1 <= 320, f 45;
#X obj 1620 230 spigot;
#X obj 1620 270 sel 0;
#X msg 1620 310 invalid_bpm;
#X obj 1620 350 s \$2-tempo-fit-error;
#X obj 1620 390 t b f;
#X obj 2100 70 loadbang;
#X obj 2100 110 v plugmlr-clock-bpm;
#X obj 2100 150 expr if($f1 >= 30 && $f1 <= 320 \, $f1 \, 120), f 45;
#X obj 2100 220 t b f;
#X obj 1100 640 r \$1-first_index;
#X obj 850 640 r \$1-last_index;
#X obj 850 760 -;
#X obj 850 700 f;
#X obj 1320 760 r \$1-sample-rate;
#X obj 550 640 r \$1-update_indexes;
#X obj 550 700 t b b;
#X obj 20 860 expr if($f2 && ($f5>0 && $f6>0 && $f1*$f5*$f4/(max($f6 \, 1e-20)*60000*max($f3 \, 1))>=0.015625 && $f1*$f5*$f4/(max($f6 \, 1e-20)*60000*max($f3 \, 1))<=64) \, $f1*$f5*$f4/(max($f6 \, 1e-20)*60000*max($f3 \, 1)) \, $f1) \; if(!$f2 \, 0 \, if(($f5>0 && $f6>0 && $f1*$f5*$f4/(max($f6 \, 1e-20)*60000*max($f3 \, 1))>=0.015625 && $f1*$f5*$f4/(max($f6 \, 1e-20)*60000*max($f3 \, 1))<=64) \, 1 \, 2)), f 130;
#X obj 650 1110 s \$1-tempo-fit-status;
#X obj 20 1110 t f f;
#X obj 250 1160 s \$1-target-rate;
#X obj 20 1160 change;
#X obj 20 1210 outlet effective_target;
