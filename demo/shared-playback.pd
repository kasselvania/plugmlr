#N canvas 80 80 850 540 12;
#X text 25 25 plugmlr R1 / reusable shared-buffer playback;
#X text 25 70 1. Double-click an instance below to open its controls.;
#X text 25 105 2. Click load ../tests/stereo-48000.wav then start A and B.;
#X text 25 140 3. Change rate / seek / region on one head. Start C through the same interface.;
#X text 25 175 4. Open the other instance to test two instruments in this SAME Pd environment.;
#X obj 25 255 r1-demo-instance;
#X obj 425 255 r1-demo-instance;
#X text 25 215 Instrument instance one;
#X text 425 215 Instrument instance two;
#X obj 300 430 dac~;
#X obj 150 320 +~;
#X obj 150 375 *~ 0.15;
#X obj 400 320 +~;
#X obj 400 375 *~ 0.15;
#X text 25 485 Enable plugdata DSP. Output mix is attenuated to leave room for six heads. No auto-start.;
#X connect 5 0 10 0;
#X connect 6 0 10 1;
#X connect 10 0 11 0;
#X connect 11 0 9 0;
#X connect 5 1 12 0;
#X connect 6 1 12 1;
