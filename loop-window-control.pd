#N canvas 100 80 1500 1000 12;
#X text 20 15 Live loop coordinates only. Args: private player ID / public track. Audio stays in the original player.;
#X obj 20 55 r \$1-loop-window;
#X obj 300 55 r \$2-loop-window;
#X obj 20 95 route start end move;
#X obj 20 320 pack f f f f f f f f f;
#X obj 700 190 samplerate~;
#X obj 700 230 expr max(1 \, ceil(abs($f2)*$f3/max(1 \, $f1)));
#X obj 900 150 r \$1-rate_multiplier;
#X obj 20 270 t f b;
#X obj 20 135 route float;
#X obj 20 175 t f b;
#X msg 110 215 0;
#X obj 240 135 route float;
#X obj 240 175 t f b;
#X msg 330 215 1;
#X obj 460 135 route float;
#X obj 460 175 t f b;
#X msg 550 215 2;
#X obj 20 650 r \$1-set_active_loop_start;
#X obj 240 650 r \$1-set_active_loop_end;
#X obj 460 650 r \$1-first_index;
#X obj 680 650 r \$1-last_index;
#X obj 900 650 r \$1-sample-rate;
#X obj 900 690 * 1000;
#X obj 1100 150 r \$1-buffer-ready;
#X obj 1300 150 r \$1-buffer-switching;
#X obj 1100 230 expr $f1 != 0 && $f2 == 0;
#X obj 1300 190 t b f;
#X obj 1100 190 f;
#X obj 20 365 unpack f f f f f f f f f;
#X obj 20 410 expr if($f2==0 \, max($f5 \, min($f4-$f8 \, floor($f1*$f7+0.5))) \, if($f2==1 \, $f3 \, max($f5 \, min($f6-($f4-$f3) \, floor($f1*$f7+0.5))))) \; if($f2==1 \, min($f6 \, max($f3+$f8 \, floor($f1*$f7+0.5))) \, if($f2==0 \, $f4 \, max($f5 \, min($f6-($f4-$f3) \, floor($f1*$f7+0.5)))+($f4-$f3))) \; ($f1-$f1)==0 && $f9!=0 && $f7>0 && $f6-$f5 >= $f8 && $f3 >= $f5 && $f4 <= $f6 && $f4>$f3 && if($f2==0 \, $f4-$f5 >= $f8 \, if($f2==1 \, $f6-$f3 >= $f8 \, $f4-$f3 >= $f8));
#X obj 20 465 pack f f;
#X obj 20 505 spigot;
#X obj 20 545 t l l b;
#X obj 450 585 s \$1-cancel-pending-slice;
#X obj 250 585 unpack f f;
#X obj 20 745 unpack f f;
#X obj 20 785 /;
#X obj 250 785 /;
#X obj 20 825 pack f f;
#X obj 20 865 list prepend keep;
#X obj 20 905 list trim;
#X obj 20 945 s \$1-loop-region-request;
#X text 450 745 Start/End clamp at each other. Move preserves length and clamps at usable content edges.;
#X text 450 785 Minimum: one source frame or one host sample at the current speed. No musical slice minimum.;
#X text 450 825 Accepted requests replace pending cuts. Committed bounds (including slices) refresh the stored window.;
